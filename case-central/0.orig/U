FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
#include "${FOAM_CASE}/system/flowDerived"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($Ux $Uy $Uz);

boundaryField
{
    // fixed where the flow enters, extrapolated where it leaves: right at
    // any Mach and any angle of attack
    "(inlet|outlet|box)"
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
        value           $internalField;
    }
    symm
    {
        type            symmetry;
    }
    "(cone|walls|tail|fins)"
    {
        type            noSlip;
    }
}

