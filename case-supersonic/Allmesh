#!/bin/sh
# Allmesh -- bring a .msh from mesh/build.py into this case.
#
#     ./Allmesh ../mesh/output/aconcagua_quarter_s1.msh
#
# gmshToFoam -> patch types -> checkMesh -> renumberMesh.  Also copies the
# .meshInfo sidecar written by build.py into constant/, which is where
# controlDict gets Aref, the wall patch list and the sector from.
#
# Run from a shell with OpenFOAM sourced:
#     source /usr/lib/openfoam/openfoam2412/etc/bashrc
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?source the OpenFOAM bashrc first}/bin/tools/RunFunctions"

MSH=$1
if [ -z "$MSH" ] || [ ! -f "$MSH" ]; then
    echo "usage: ./Allmesh path/to/mesh.msh"
    echo "       (build one with: cd ../mesh && python3 build.py --preset coarse)"
    exit 1
fi
INFO="${MSH%.msh}.meshInfo"

rm -rf constant/polyMesh log.gmshToFoam log.checkMesh log.renumberMesh

echo "== gmshToFoam  ($MSH)"
runApplication gmshToFoam "$MSH" || exit 1

echo "== meshInfo"
if [ -f "$INFO" ]; then
    cp "$INFO" constant/meshInfo
    echo "   constant/meshInfo <- $INFO"
    echo "   sector $(foamDictionary -entry sector -value constant/meshInfo), " \
         "Aref $(foamDictionary -entry Aref -value constant/meshInfo) m2, " \
         "walls $(foamDictionary -entry wallPatches -value constant/meshInfo)"
else
    echo "   !! no $INFO next to the mesh."
    echo "   Keeping the existing constant/meshInfo -- make sure its sector, Aref"
    echo "   and patch list match this mesh, or forceCoeffs will be wrong/abort."
fi

echo "== patch types  (gmshToFoam makes them ALL 'patch')"
python3 fixPatchTypes.py || { echo "!! patch fix FAILED -- stop, do not run"; exit 1; }

echo "== checkMesh"
runApplication checkMesh -allGeometry -allTopology

echo "== renumberMesh"
runApplication renumberMesh -overwrite

echo
echo "done.  From log.checkMesh:"
grep -E "cells:|hexahedra|polyhedra|non-orthogonality|skewness|aspect ratio|Failed|Mesh OK|\*\*\*" log.checkMesh | sed 's/^/   /'
echo
echo "next: edit system/flowConditions (alpha, beta, Uinf), then ./Allrun [nproc]"
echo "      optional, first: ./Allrefine [tip|fins]  -- local refinement at the fins"
