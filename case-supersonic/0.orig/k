FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
#include "${FOAM_CASE}/system/flowDerived"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    "(inlet|outlet|box)"
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    symm
    {
        type            symmetry;
    }
    "(cone|walls|tail|fins)"
    {
        type            kLowReWallFunction;
        value           $internalField;
    }
}

