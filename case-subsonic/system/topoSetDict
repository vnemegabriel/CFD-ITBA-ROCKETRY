FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// ============================================================================
//  Cell sets for the OPTIONAL local refinement around the fins (./Allrefine).
//
//  The fin geometry comes from constant/meshInfo, which mesh/build.py writes
//  next to every .msh, so these regions follow the fins if the geometry
//  changes.  Nothing here repeats a number that lives somewhere else.
//
//  Two sets, both a cylinder sector about the body axis, differing only in
//  whether the region reaches the body wall:
//
//    finTip   an annular band around the fin TIP.  Starts at rIn, well
//             outside the body, so it does NOT touch the boundary layer and
//             y+ is unchanged.  This is the cheap one.
//    finBox   the same cylinder without the hole: the whole fin, root to tip.
//             Reaches the body wall, so refining it HALVES the first cell
//             there and y+ drops to about half under the fins.
//
//  ./Allrefine tip     uses finTip
//  ./Allrefine fins    uses finBox
// ============================================================================
#include "${FOAM_CASE}/constant/meshInfo"

// ---- the region: the only thing you edit -----------------------------------
margin          0.020;      // m  clearance around the fin planform
wake            0.050;      // m  how far past the trailing edge to follow the
                            //    tip vortex
tipBand         0.050;      // m  thickness of the tip band, inward from the tip

// ---- derived: do not edit --------------------------------------------------
xLo             #eval{ $finX0 - $margin };
xHi             #eval{ $finX1 + $margin + $wake };
rOut            #eval{ $finTipR + $finTipSmear + $margin };
rIn             #eval{ $finTipR - $tipBand };

actions
(
    {
        name        finTip;
        type        cellSet;
        action      new;
        source      cylinderToCell;
        point1      ($xLo 0 0);
        point2      ($xHi 0 0);
        radius      $rOut;
        innerRadius $rIn;
    }
    {
        name        finBox;
        type        cellSet;
        action      new;
        source      cylinderToCell;
        point1      ($xLo 0 0);
        point2      ($xHi 0 0);
        radius      $rOut;
    }
);

