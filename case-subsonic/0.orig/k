FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
#include "${FOAM_CASE}/system/flowDerived"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    box
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    symm
    {
        type            symmetry;
    }
    // y+ ~ 30 at the first cell centre.  kLowRe is y+-continuous, so it
    // stays valid where y+ drifts (fin tips, boattail) -- same reason as the
    // Spalding nut wall function.
    "(cone|walls|tail|fins)"
    {
        type            kLowReWallFunction;
        value           $internalField;
    }
}

