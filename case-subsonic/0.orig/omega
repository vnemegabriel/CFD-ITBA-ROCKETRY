FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
#include "${FOAM_CASE}/system/flowDerived"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    box
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    symm
    {
        type            symmetry;
    }
    "(cone|walls|tail|fins)"
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}

