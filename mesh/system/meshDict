/*--------------------------------*- C++ -*----------------------------------*\
|  cfMesh (cartesianMesh) settings for the Aconcagua.                         |
|                                                                             |
|  THE POINT OF THIS FILE IS THAT IT IS SHORT.  The structured generator it    |
|  replaces carried 49 coupled parameters -- FIN_X_LEAD tied to the sweep,     |
|  FIN_H_R setting both the tip cell and the chamfer, four AZ_RELAX anchors    |
|  shaping a blend -- and getting one wrong produced a different mesh with no  |
|  error.  Everything here is a LEVEL: an integer that halves a cell size,     |
|  local to one patch or one box, with no coupling to anything else.  Get one  |
|  wrong and the cells are visibly too big or too small, right there.          |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      meshDict;
}
// ============================================================================

surfaceFile "geometry.fms";

// The ONE size everything else is derived from.  Every `additionalRefinement-
// Levels N` below means maxCellSize / 2^N:
//
//      level  4 -> 100    mm        level  9 ->  3.13 mm
//      level  6 ->  25    mm        level 10 ->  1.56 mm
//      level  8 ->   6.25 mm        level 11 ->  0.78 mm
maxCellSize 1.6;

// ---------------------------------------------------------------- surfaces --
// One entry per patch of the .fms: the solids of Aconcagua.stl AFTER the
// rename in Allmesh.  A name that matches nothing is only a warning.
// `refinementThickness` is how far the level is carried off the wall; below
// that the octree grades back to maxCellSize on its own.
localRefinement
{
    cone
    {
        // the bow shock stands off the tip: this is the band it lives in
        additionalRefinementLevels 8;
        refinementThickness 0.060;
    }

    walls
    {
        additionalRefinementLevels 8;
        refinementThickness 0.050;
    }

    tail
    {
        // the expansion over the boattail sets the base pressure, and base
        // drag is a large share of the Cd this mesh exists to produce
        additionalRefinementLevels 8;
        refinementThickness 0.050;
    }

    fins
    {
        // metres, not a level: the fin is 6 mm thick at every maxCellSize.
        // Above ~3 mm the layers tangle (docs/TROUBLESHOOTING.md).
        cellSize            0.003125;
        refinementThickness 0.020;
    }
}

// ------------------------------------------------------------------ boxes --
// Volume refinement, which is the thing the structured mesher could not do
// locally: its radial zone was a cylinder running the whole 59 m of domain.
objectRefinements
{
    nearField
    {
        type        box;
        additionalRefinementLevels 5;      // 50 mm
        centre      (1.500 0 0);
        lengthX     3.400;
        lengthY     1.000;
        lengthZ     1.000;
    }

    baseWake
    {
        type        cone;
        additionalRefinementLevels 8;      // 6.25 mm, same as the tail wall
        p0          (2.940 0 0);
        p1          (3.300 0 0);
        radius0     0.080;
        radius1     0.080;
    }

    nearWake
    {
        type        cone;
        additionalRefinementLevels 7;      // 12.5 mm
        p0          (2.900 0 0);
        p1          (3.800 0 0);
        radius0     0.140;
        radius1     0.140;
    }

    midWake
    {
        type        cone;
        additionalRefinementLevels 6;      // 25 mm
        p0          (2.850 0 0);
        p1          (5.000 0 0);
        radius0     0.260;
        radius1     0.260;
    }

    wake
    {
        type        box;
        additionalRefinementLevels 4;      // 100 mm
        centre      (5.000 0 0);
        lengthX     8.000;
        lengthY     1.600;
        lengthZ     1.600;
    }

    // Nested boxes, one level each and twice the size of the one inside, so
    // the cell grows with the distance to the rocket instead of jumping.
    around4
    {
        type        box;
        additionalRefinementLevels 4;      // 100 mm
        centre      (2.000 0 0);
        lengthX     6.000;
        lengthY     2.000;
        lengthZ     2.000;
    }

    around3
    {
        type        box;
        additionalRefinementLevels 3;      // 200 mm
        centre      (5.000 0 0);
        lengthX     14.00;
        lengthY     4.000;
        lengthZ     4.000;
    }

    farWake
    {
        type        box;
        additionalRefinementLevels 2;      // 400 mm
        centre      (11.50 0 0);
        lengthX     31.00;
        lengthY     8.000;
        lengthZ     8.000;
    }

    around1
    {
        type        box;
        additionalRefinementLevels 1;      // 800 mm
        centre      (13.50 0 0);
        lengthX     43.00;
        lengthY     16.00;
        lengthZ     16.00;
    }
}

// ------------------------------------------------------------------ layers --
// The boundary layer is EXTRUDED, not octree-refined, so y1 is set by nLayers
// and thicknessRatio against the local surface cell rather than solved for.
// Check y+ on the first run and tune nLayers; that is the one place where the
// structured generator was more direct (it solved y1 from YPLUS_TARGET).
boundaryLayers
{
    nLayers         1;
    thicknessRatio  1.2;

    patchBoundaryLayers
    {
        cone     { nLayers 10; }
        walls    { nLayers 10; }
        tail     { nLayers 10; }
        fins     { nLayers 3; allowDiscontinuity 1; }
    }

    optimiseLayer 1;
    untangleLayers 1;
    optimisationParameters
    {
        nSmoothNormals   5;
        maxNumIterations 5;
        featureSizeFactor 0.3;
        reCalculateNormals 1;
        relThicknessTol  0.03;
    }
}

// ************************************************************************* //
