/*--------------------------------*- C++ -*----------------------------------*\
|  The wall patches already come out of cfMesh with the names the cases        |
|  expect, because Allmesh renames the solids of the STL before meshing.       |
|  All this file does is turn the six faces of the bounding box into the       |
|  three patches the cases know: inlet, outlet, and one `box` farfield.        |
|  Types are set afterwards by fixPatchTypes.py in the case, from meshInfo.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      createPatchDict;
}
// ============================================================================
pointSync false;

patches
(
    {
        name inlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (xMin);
    }
    {
        name outlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (xMax);
    }
    {
        // the four lateral faces become one farfield, so the cases see the
        // same patch list a quarter/half/full structured mesh gave them
        name box;
        patchInfo { type patch; }
        constructFrom patches;
        patches (yMin yMax zMin zMax);
    }
);
// ************************************************************************* //
