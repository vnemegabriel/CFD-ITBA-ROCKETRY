FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
#include "${FOAM_CASE}/system/flowDerived"

dimensions      [1 -1 -2 0 0 0 0];      // Pa: COMPRESSIBLE, not p/rho

internalField   uniform $pInf;

boundaryField
{
    "(inlet|outlet|box)"
    {
        type            freestreamPressure;
        freestreamValue $internalField;
        value           $internalField;
    }
    symm
    {
        type            symmetry;
    }
    "(cone|walls|tail|fins)"
    {
        type            zeroGradient;
    }
}

