FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// CORRECTIONS
//  [FATAL] pRefPoint was (0.51 0.51 0.51). The domain is z in [-12, 0], so
//          z = +0.51 is OUTSIDE the mesh - an immediate fatal error. Not
//          needed at all here: the outlet fixes p, so the system is not
//          singular and no reference cell is required.
//  [FATAL] Solver blocks were for a VoF case (alpha.water sub-cycles, p_rgh).
//          simpleFoam solves `p` (KINEMATIC pressure, m^2/s^2).
//  [FIX]   momentumPredictor no is wrong for external aerodynamics - the
//          momentum predictor is what carries convection of the boundary
//          layer. It is a PIMPLE key in any case; SIMPLE has no such switch.
//  [FIX]   relaxationFactors ".*" 1 with no pressure relaxation would diverge
//          immediately in SIMPLE. Using SIMPLEC (consistent yes), which allows
//          equation relaxation near 0.9 and needs no explicit p relaxation.

solvers
{
    p
    {
        solver           GAMG;
        smoother         GaussSeidel;
        tolerance        1e-7;
        relTol           0.01;
        nPreSweeps       0;
        nPostSweeps      2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 100;
        agglomerator     faceAreaPair;
        mergeLevels      1;
    }

    Phi                             // potentialFoam initialisation
    {
        $p;
        relTol           0;
    }

    "(U|k|omega)"
    {
        solver           smoothSolver;
        smoother         symGaussSeidel;
        tolerance        1e-8;
        relTol           0.1;
        nSweeps          1;
        minIter          1;
    }
}

SIMPLE
{
    consistent                  yes;    // SIMPLEC
    nNonOrthogonalCorrectors      1;

    residualControl
    {
        p           1e-5;
        U           1e-6;
        "(k|omega)" 1e-6;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    equations
    {
        U           0.9;
        ".*"        0.9;
    }
}

cache
{
    grad(U);
}

