FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDictBase;
}
#include "${FOAM_CASE}/system/flowDerived"
#include "${FOAM_CASE}/constant/meshInfo"

// rhoCentralFoam: density-based, explicit, central-upwind shock capturing.
application     rhoCentralFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;

// Physical seconds, ten flow-through times of the body.
// rhoCentralFoam takes its FIRST step at 1.2 deltaT without looking at maxCo,
// so deltaT has to start below the stable step: maxCo 0.01 times tauCo.
deltaT          {{ '%.3g'|format(0.01*tauCo/1.2) }};
endTime         #eval{ 10*$lBody/$Uinf };

writeControl    adjustable;
writeInterval   0.005;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

// The step is raised until the worst cell sits at maxCo, then capped at
// maxDeltaT.  maxCo is NOT set here: system/controlDict and every
// fileUpdaterControlDict/controlDict_* include this file and add their own,
// and system/fileUpdater swaps them as the run advances.
adjustTimeStep  yes;
maxDeltaT       1e-5;

functions
{
    // -- Force coefficients ------------------------------------------------
    //  Compressible: p is in Pa, so the force integration uses the rho FIELD.
    //  rhoInf is still needed for the dynamic pressure that normalises the
    //  coefficients.  Aref, lRef and the wall patches come from
    //  constant/meshInfo, so they always match the mesh.
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   50;
        log             yes;
        patches         $wallPatches;
        rho             rho;
        rhoInf          $rhoInf;
        dragDir         ($dx $dy $dz);
        liftDir         ($lx $ly $lz);
        CofR            (0 0 0);
        pitchAxis       (0 0 1);
        magUInf         $Uinf;
        lRef            $lRef;
        Aref            $Aref;
    }

    forces1
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   50;
        log             no;
        patches         $wallPatches;
        rho             rho;
        rhoInf          $rhoInf;
        CofR            (0 0 0);
    }

    // -- Mach number: the field to look at.  The bow shock, the expansion
    //    over the boattail and the Mach cone all show up here first.
    MachNo
    {
        type            MachNo;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        writeControl    timeStep;
        fields          (U e k omega);
        writeResidualFields no;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        patches         $wallPatches;
    }
    Cp
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        mode            staticCoeff;
        rho             rhoInf;
        rhoInf          $rhoInf;
        pInf            $pInf;
        UInf            ($Ux $Uy $Uz);
        writeControl    writeTime;
    }

    #include "${FOAM_CASE}/system/fileUpdater"
}

