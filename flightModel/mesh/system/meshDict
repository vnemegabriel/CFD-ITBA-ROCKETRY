/*--------------------------------*- C++ -*----------------------------------*\
|  cfMesh (cartesianMesh) settings for the Aconcagua.                         |
|                                                                             |
|  THE POINT OF THIS FILE IS THAT IT IS SHORT.  The structured generator it    |
|  replaces carried 49 coupled parameters -- FIN_X_LEAD tied to the sweep,     |
|  FIN_H_R setting both the tip cell and the chamfer, four AZ_RELAX anchors    |
|  shaping a blend -- and getting one wrong produced a different mesh with no  |
|  error.  Everything here is a LEVEL: an integer that halves a cell size,     |
|  local to one patch or one box, with no coupling to anything else.  Get one  |
|  wrong and the cells are visibly too big or too small, right there.          |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      meshDict;
}
// ============================================================================

surfaceFile "geometry.fms";

// The ONE size everything else is derived from.  Every `additionalRefinement-
// Levels N` below means maxCellSize / 2^N:
//
//      level  4 -> 100    mm        level  9 ->  3.13 mm
//      level  6 ->  25    mm        level 10 ->  1.56 mm
//      level  8 ->   6.25 mm        level 11 ->  0.78 mm
maxCellSize 1.6;

// ---------------------------------------------------------------- surfaces --
// One entry per patch of the .fms: the solids of Aconcagua.stl AFTER the
// rename in Allmesh.  A name that matches nothing is only a warning.
// `refinementThickness` is how far the level is carried off the wall; below
// that the octree grades back to maxCellSize on its own.
localRefinement
{
    cone
    {
        // the bow shock stands off the tip: this is the band it lives in
        additionalRefinementLevels 8;
        refinementThickness 0.060;
    }

    walls
    {
        additionalRefinementLevels 8;
        refinementThickness 0.050;
    }

    tail
    {
        // the expansion over the boattail sets the base pressure, and base
        // drag is a large share of the Cd this mesh exists to produce
        additionalRefinementLevels 8;
        refinementThickness 0.050;
    }

    fins
    {
        // 3.13 mm against the 5 mm the structured mesh put on the chord, and
        // the leading edge is a FEATURE EDGE, so it is meshed to rather than
        // quantised to the cell.  Level 10 (1.56 mm) is affordable once the
        // first run has shown what the levels below cost.
        additionalRefinementLevels 9;
        refinementThickness 0.020;
    }
}

// ------------------------------------------------------------------ boxes --
// Volume refinement, which is the thing the structured mesher could not do
// locally: its radial zone was a cylinder running the whole 59 m of domain.
// The numbers are for the Aconcagua (lBody 2.955 m, rBody 0.0755 m); the
// regions scale with the rocket, axially by sx and radially by sr.  Allmesh
// writes lBody and rBody from meshInfo.
lBody       2.955;
rBody       0.0755;
sx          #eval{ $lBody/2.955 };
sr          #eval{ $rBody/0.0755 };

objectRefinements
{
    noseTip
    {
        // stagnation point and the bow shock standoff, at the fin level
        type        sphere;
        additionalRefinementLevels 9;      // 3.13 mm
        centre      (0 0 0);
        radius      #eval{ 0.040*$sr };
    }

    noseApex
    {
        // the curve of the tip itself; two levels above the fins
        type        sphere;
        additionalRefinementLevels 11;     // 0.78 mm
        centre      (0 0 0);
        radius      #eval{ 0.010*$sr };
    }

    shoulder
    {
        // the expansion where the boattail starts
        type        hollowCone;
        additionalRefinementLevels 9;      // 3.13 mm
        p0          (#eval{ 2.810*$sx } 0 0);
        p1          (#eval{ 2.850*$sx } 0 0);
        radius0_Inner #eval{ 0.065*$sr };
        radius0_Outer #eval{ 0.090*$sr };
        radius1_Inner #eval{ 0.065*$sr };
        radius1_Outer #eval{ 0.090*$sr };
    }

    baseEdge
    {
        // the base shear layer leaves from this edge
        type        hollowCone;
        additionalRefinementLevels 10;     // 1.56 mm
        p0          (#eval{ 2.940*$sx } 0 0);
        p1          (#eval{ 2.970*$sx } 0 0);
        radius0_Inner #eval{ 0.045*$sr };
        radius0_Outer #eval{ 0.065*$sr };
        radius1_Inner #eval{ 0.045*$sr };
        radius1_Outer #eval{ 0.065*$sr };
    }

    nearField
    {
        type        box;
        additionalRefinementLevels 5;      // 50 mm
        centre      (#eval{ 1.500*$sx } 0 0);
        lengthX     #eval{ 3.400*$sx };
        lengthY     #eval{ 1.000*$sr };
        lengthZ     #eval{ 1.000*$sr };
    }

    baseWake
    {
        type        cone;
        additionalRefinementLevels 8;      // 6.25 mm, same as the tail wall
        p0          (#eval{ 2.940*$sx } 0 0);
        p1          (#eval{ 3.300*$sx } 0 0);
        radius0     #eval{ 0.080*$sr };
        radius1     #eval{ 0.080*$sr };
    }

    nearWake
    {
        type        cone;
        additionalRefinementLevels 7;      // 12.5 mm
        p0          (#eval{ 2.900*$sx } 0 0);
        p1          (#eval{ 3.800*$sx } 0 0);
        radius0     #eval{ 0.140*$sr };
        radius1     #eval{ 0.140*$sr };
    }

    midWake
    {
        type        cone;
        additionalRefinementLevels 6;      // 25 mm
        p0          (#eval{ 2.850*$sx } 0 0);
        p1          (#eval{ 5.000*$sx } 0 0);
        radius0     #eval{ 0.260*$sr };
        radius1     #eval{ 0.260*$sr };
    }

    wake
    {
        type        box;
        additionalRefinementLevels 4;      // 100 mm
        centre      (#eval{ 5.000*$sx } 0 0);
        lengthX     #eval{ 8.000*$sx };
        lengthY     #eval{ 1.600*$sr };
        lengthZ     #eval{ 1.600*$sr };
    }

    farWake
    {
        type        box;
        additionalRefinementLevels 2;      // 400 mm
        centre      (#eval{ 14.00*$sx } 0 0);
        lengthX     #eval{ 26.00*$sx };
        lengthY     #eval{ 4.000*$sr };
        lengthZ     #eval{ 4.000*$sr };
    }
}

// ------------------------------------------------------------------ edges --
// Leading and trailing edges of the fins: the oblique shock starts at the LE,
// the expansion at the TE.  finEdges.obj is written by makeRocket.py next to
// the STL and copied by Allmesh.
edgeMeshRefinement
{
    finEdges
    {
        edgeFile    "finEdges.obj";
        additionalRefinementLevels 10;     // 1.56 mm
        refinementThickness 0.010;
    }

    finRoots
    {
        // the root of each fin, LE to TE on the body.  It refines the body
        // wall too, so the body layers here are about 7 times thinner
        edgeFile    "finRoots.obj";
        additionalRefinementLevels 11;     // 0.78 mm
        refinementThickness 0.008;
    }
}

// ------------------------------------------------------------------ layers --
// The boundary layer is EXTRUDED, not octree-refined, so y1 is set by nLayers
// and thicknessRatio against the local surface cell rather than solved for.
// cfMesh splits the layer only on patches listed below: the global nLayers
// reaches the domain faces too, so it stays at 1.  Allmesh --nLayers and
// --thicknessRatio set cone, walls and tail so that y1 = 0.241 mm on every
// maxCellSize.  The fins stay at 3 layers.
boundaryLayers
{
    nLayers         1;

    patchBoundaryLayers
    {
        cone     { nLayers 10; thicknessRatio 1.2; }
        walls    { nLayers 10; thicknessRatio 1.2; }
        tail     { nLayers 10; thicknessRatio 1.2; }
        fins     { nLayers 3;  thicknessRatio 1.2; allowDiscontinuity 1; }
    }

    optimiseLayer 1;
    untangleLayers 1;
    optimisationParameters
    {
        nSmoothNormals   5;
        maxNumIterations 5;
        featureSizeFactor 0.3;
        reCalculateNormals 1;
        relThicknessTol  0.03;
    }
}

