/*--------------------------------*- C++ -*----------------------------------*\
|  Turns the six faces of the bounding box into inlet, outlet and one box     |
|  farfield.  The wall patches come out of cartesianMesh already named and    |
|  typed wall, and Allmesh checks it.                                         |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      createPatchDict;
}
// ============================================================================
pointSync false;

patches
(
    {
        name inlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (xMin);
    }
    {
        name outlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (xMax);
    }
    {
        name box;
        patchInfo { type patch; }
        constructFrom patches;
        patches (yMin yMax zMin zMax);
    }
);
// ************************************************************************* //
