FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }
    pFinal
    {
        $p;
    }

    "(rho|U|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.1;
    }
    "(rho|U|e|k|omega)Final"
    {
        $U;
    }
}

PIMPLE
{
    momentumPredictor        yes;
    transonic                yes;
    nOuterCorrectors         1;
    nCorrectors              2;
    nNonOrthogonalCorrectors 1;

    pMinFactor               0.05;
    pMaxFactor               6;

    // localEuler reads these here, not from controlDict
    maxCo                    {{ maxCo }};
    rDeltaTSmoothingCoeff    0.1;
    rDeltaTDampingCoeff      0.9;
    maxDeltaT                1;
}

