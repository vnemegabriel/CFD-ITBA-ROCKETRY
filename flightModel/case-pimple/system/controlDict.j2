FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
#include "${FOAM_CASE}/system/flowDerived"
#include "${FOAM_CASE}/constant/meshInfo"

application     rhoPimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;

// localEuler: time counts iterations.  maxCo is in fvSolution/PIMPLE.
deltaT          1;
endTime         {{ endIter }};
adjustTimeStep  no;

writeControl    timeStep;
writeInterval   500;
purgeWrite      1;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    #include "${FOAM_CASE}/system/FOs/FOcommon"

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        writeControl    timeStep;
        writeInterval   50;
        fields          (U p e k omega);
        writeResidualFields no;
    }

    #include "${FOAM_CASE}/system/FOs/FOrunTimeControl"
}

