#!/bin/sh
# Allrefine -- OPTIONAL local 2:1 refinement around the fins.
#
#     ./Allrefine            the fin-tip band (default)
#     ./Allrefine tip        the same
#     ./Allrefine fins       the whole fin, root to tip, reaching the body wall
#
# Runs BEFORE ./Allrun, on a mesh with no fields yet.  The
# region comes from system/topoSetDict, which reads the fin geometry from
# constant/meshInfo, so it follows the fins if the geometry changes.
#
# For drag at zero incidence you probably do not need it; for the tip vortex
# at incidence you do.  See docs/WORKFLOW.md section 7.
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?source the OpenFOAM bashrc first}/bin/tools/RunFunctions"

case "${1:-tip}" in
    tip)  SET=finTip ;;
    fins) SET=finBox ;;
    *)    echo "usage: ./Allrefine [tip|fins]"; exit 1 ;;
esac

[ -d constant/polyMesh ] || {
    echo "no mesh: run mesh/Allmesh first"; exit 1; }
# newCase.sh links the shared mesh; refineMesh -overwrite would change it for every case
if [ -L constant/polyMesh ]; then
    SHARED=$(readlink -f constant/polyMesh)
    rm constant/polyMesh
    cp -r "$SHARED" constant/polyMesh
fi

# refineMesh maps any fields it finds; running it on a case that already has
# fields silently refines those instead of starting from a clean mesh.  Test
# for a field, not for the directory: refineMesh itself creates 0/polyMesh to
# drop a cellMap in, and that alone is not a reason to stop.
[ -f 0/U ] && {
    echo "!! this case already has fields in 0/: refine BEFORE running,"
    echo "   or ./Allclean and start again"
    exit 1; }

[ "$(foamDictionary -entry fins -value constant/meshInfo 2>/dev/null)" = "true" ] || {
    echo "!! constant/meshInfo says this mesh has no fins"; exit 1; }

foamDictionary -entry finTipR -value constant/meshInfo > /dev/null 2>&1 || {
    echo "!! constant/meshInfo carries no fin geometry (finTipR, finX0, ...)."
    echo "   Copy mesh/meshInfo over it."
    exit 1; }

rm -f log.topoSet log.refineMesh log.checkMesh.refine log.renumberMesh.refine

echo "== topoSet  (region from constant/meshInfo + system/topoSetDict)"
runApplication topoSet || exit 1
BEFORE=$(awk '/^    cells:/{print $2; exit}' log.checkMesh 2>/dev/null)

echo "== refineMesh  (set $SET, 2:1 in all three directions)"
foamDictionary -entry set -set "$SET" system/refineMeshDict > /dev/null
runApplication refineMesh -dict system/refineMeshDict -overwrite || exit 1

# refineMesh writes 0/polyMesh/cellMap, a new-to-old cell map for mapping
# fields across the refinement.  There are no fields yet -- that is the point
# of refining here -- and leaving it behind makes ParaView show a time 0 with
# its own mesh, and makes a second ./Allrefine look like it is about to
# refine a result.
rm -rf 0/polyMesh
rmdir 0 2>/dev/null || true

echo "== checkMesh"
runApplication -s refine checkMesh -allGeometry -allTopology
AFTER=$(awk '/^    cells:/{print $2; exit}' log.checkMesh.refine)

echo "== renumberMesh"
runApplication -s refine renumberMesh -overwrite

# keep the sidecar honest: controlDict reads nCells from it
[ -n "$AFTER" ] && foamDictionary -entry nCells -set "$AFTER" constant/meshInfo > /dev/null 2>&1

echo
echo "cells: ${BEFORE:-?} -> ${AFTER:-?}"
grep -E "hexahedra|polyhedra:|non-orthogonality Max|Max skewness" log.checkMesh.refine | sed 's/^/   /'
if [ "$SET" = finBox ]; then
    echo
    echo "NOTE: this region reaches the body wall, so the first cell there is now"
    echo "      half as thick and y+ under the fins is about half of the rest of"
    echo "      the body.  nutUSpaldingWallFunction copes, but a drag breakdown"
    echo "      per component is comparing patches at two different y+."
fi
echo
echo "next: ./Allrun [nproc]"
