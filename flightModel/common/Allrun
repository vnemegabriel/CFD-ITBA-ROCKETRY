#!/bin/sh
# Allrun -- run the case on the mesh newCase.sh brought in.
#
#     ./Allrun            parallel, numberOfSubdomains from decomposeParDict
#     ./Allrun 16         parallel on 16 cores (updates decomposeParDict)
#     ./Allrun 1          serial
#
# Refuses to start if system/flowConditions asks for an angle the mesh's
# sector cannot represent (see constant/meshInfo).
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?source the OpenFOAM bashrc first}/bin/tools/RunFunctions"
LC_ALL=C; export LC_ALL

[ -d constant/polyMesh ] || { echo "no mesh: run mesh/Allmesh first"; exit 1; }

# ---- consistency: angles vs sector -----------------------------------------
SECTOR=$(foamDictionary -entry sector -value constant/meshInfo)
ALPHA=$(foamDictionary -entry alpha -value system/flowConditions)
BETA=$(foamDictionary -entry beta -value system/flowConditions)
echo "sector $SECTOR   alpha $ALPHA deg   beta $BETA deg"
case "$SECTOR" in
    quarter)
        if [ "$(echo "$ALPHA $BETA" | awk '{print ($1 != 0 || $2 != 0)}')" = 1 ]; then
            echo "!! quarter mesh: two symmetry planes, alpha and beta must be 0."
            echo "   Needs a half (alpha) or full (alpha, beta) mesh."
            exit 1
        fi ;;
    half)
        if [ "$(echo "$BETA" | awk '{print ($1 != 0)}')" = 1 ]; then
            echo "!! half mesh: symmetry plane z = 0, beta must be 0.  Needs a full mesh."
            exit 1
        fi ;;
esac

# ---- processors --------------------------------------------------------------
if [ -n "$1" ]; then
    foamDictionary -entry numberOfSubdomains -set "$1" system/decomposeParDict > /dev/null
fi
NP=$(getNumberOfProcessors)

restore0Dir

# ---- initial field from another run ------------------------------------------
# mapFields brings the internal field and the patch values of that run's latest
# time.  A fixedValue patch must keep this run's value, so changeDictionary
# puts it back.
if [ -f initFrom ]; then
    SRC=$(cat initFrom)
    TSRC=$(foamListTimes -case "$SRC" -latestTime 2>/dev/null)
    [ -n "$TSRC" ] || { echo "!! $SRC has no solution to start from"; exit 1; }
    {
        echo 'FoamFile { version 2.0; format ascii; class dictionary; object changeDictionaryDict; }'
        for f in 0/*; do
            for P in $(foamDictionary -entry entry0 -keywords constant/polyMesh/boundary); do
                [ "$(foamDictionary -entry "boundaryField/$P/type" -value "$f" 2>/dev/null)" = fixedValue ] || continue
                echo "${f#0/} { boundaryField { $P { value $(foamDictionary -entry "boundaryField/$P/value" -value "$f"); } } }"
            done
        done
    } > system/changeDictionaryDict.init
    runApplication -overwrite mapFields "$SRC" -consistent -sourceTime latestTime
    runApplication -overwrite changeDictionary -dict system/changeDictionaryDict.init -time 0
    if ! tail -n 3 log.mapFields | grep -q "^End" || ! tail -n 3 log.changeDictionary | grep -q "^End"; then
        echo "!! starting from $SRC failed: see log.mapFields, log.changeDictionary"; exit 1
    fi
    echo "initial field: $SRC, time $TSRC"
fi

APP=$(getApplication)

BINDING=none; MPIOPTS=--oversubscribe
SOCKET=$(cat socket 2>/dev/null)
if [ -z "$SOCKET" ] && [ "$(lscpu -p=SOCKET | grep -v '^#' | sort -u | wc -l)" = 1 ] &&
   [ "$NP" -le "$(lscpu -p=CORE | grep -v '^#' | sort -un | wc -l)" ]; then
    SOCKET=0
fi
[ "$SOCKET" = none ] && SOCKET=""
if [ -n "$SOCKET" ] && [ "$NP" -gt 1 ]; then
    CORES=$(lscpu -p=SOCKET,CORE | awk -F, -v s="$SOCKET" '$1 == s {print $2}' | sort -un | wc -l)
    [ "$NP" -le "$CORES" ] || { echo "!! $NP processes do not fit in the $CORES cores of socket $SOCKET"; exit 1; }
    i=0; : > rankfile
    while [ $i -lt "$NP" ]; do echo "rank $i=localhost slot=$SOCKET:$i" >> rankfile; i=$((i + 1)); done
    OMPI_MCA_rmaps_rank_file_path=$PWD/rankfile; export OMPI_MCA_rmaps_rank_file_path
    MPIOPTS="--bind-to core"
    BINDING="socket $SOCKET, one process per core"
fi
STAMP=$(date +%Y%m%d-%H%M%S)
START=$(date +%s)
STARTISO=$(date -Iseconds)

[ "$NP" -gt 1 ] && runApplication decomposePar -force

# ---- measurement: docs/guide, Measurement of the computer ------------------
ML=""; PERF=""; EPID=""; MPID=""; SNAP=""
stopMeasure() {
    [ -n "$MPID" ] && kill -TERM "$MPID" 2> /dev/null && wait "$MPID"
    [ -n "$EPID" ] && pkill -P "$EPID" sleep; [ -n "$EPID" ] && wait "$EPID"
    MPID=""; EPID=""
}
trap stopMeasure EXIT
trap 'exit 1' INT TERM
[ -f machineLog.py ] && ML="python3 -I machineLog.py"
EVENTS=task-clock,cycles,instructions,stalled-cycles-frontend,cache-misses,cpu-migrations,context-switches
if perf stat -x, -e cycles -- true > /dev/null 2>&1; then
    PERF="perf stat -x, -I 30000 -o log.perf -e $EVENTS --"
else
    echo "!! perf cannot count cycles: set kernel.perf_event_paranoid <= 1"
fi
if perf stat -a -x, -e power/energy-pkg/ -- true > /dev/null 2>&1; then
    perf stat -a -x, -I 30000 -o log.energy -e power/energy-pkg/ -- sleep 31536000 &
    EPID=$!
fi
if [ -n "$ML" ]; then
    SNAP=$($ML snapshot | sed 's/^/    /')
    $ML sample log.machine 30 &
    MPID=$!
fi
[ "$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo performance)" = performance ] ||
    echo "!! platform_profile is not performance: the cost will not compare"

SOLVER_START=$(date +%s)
if [ "$NP" -gt 1 ]; then
    # runParallel always adds --oversubscribe, and Open MPI 5 then ignores the rankfile
    echo "Running $APP ($NP processes, $BINDING) on $PWD"
    $PERF /usr/bin/time -v -o log.time mpirun $MPIOPTS -n "$NP" "$APP" -parallel < /dev/null > "log.$APP" 2>&1
else
    $PERF /usr/bin/time -v -o log.time sh -c '. "$WM_PROJECT_DIR/bin/tools/RunFunctions"; runApplication "$1"' sh "$APP"
fi
SOLVER_END=$(date +%s)
stopMeasure
[ "$NP" -gt 1 ] && runApplication reconstructPar -latestTime
END=$(date +%s)

# ---- record ------------------------------------------------------------------
STATUS=failed
grep -q '^End' "log.$APP" && STATUS=ok
NCELLS=$(foamDictionary -entry nCells -value constant/meshInfo)
STEPS=$(grep -c '^Time = ' "log.$APP")
T0=$(awk '/^Time = /{print $3; exit}' "log.$APP")
T1=$(awk '/^Time = /{t = $3} END{print t}' "log.$APP")
RSS=$(awk -F': ' '/Maximum resident/{print $2}' log.time)
CD=$(tail -n 1 postProcessing/forceCoeffs1/*/coefficient.dat 2>/dev/null | tail -n 1 | awk '{print $2}')
WALL=$((END - START))
COST=$(awk -v w=$WALL -v n=$NP -v c=$NCELLS -v s=$STEPS 'BEGIN{print (s > 0) ? w*n*1e6/(c*s) : 0}')
MEASURED=""
[ -n "$ML" ] && MEASURED=$($ML summary log.machine log.perf log.energy | sed 's/^/    /')
CYCLES=$(echo "$MEASURED" | awk '$1 == "cycles" {sub(";", "", $2); print $2}')
CPCS=$(awk -v y="${CYCLES:-0}" -v c=$NCELLS -v s=$STEPS 'BEGIN{print (y > 0 && s > 0) ? y/(c*s) : 0}')

cat >> run.info <<EOF

run_$STAMP
{
    host        "$(hostname)";
    cpu         "$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo)";
    np          $NP;
    binding     "$BINDING";
    start       "$STARTISO";
    end         "$(date -Iseconds)";
    status      $STATUS;
    wallSeconds $WALL;
    solverWallSeconds $((SOLVER_END - SOLVER_START));
    steps       $STEPS;
    simTime     (${T0:-0} ${T1:-0});
    maxRSSkB    ${RSS:-0};
    coreUsPerCellStep $COST;
    cyclesPerCellStep $CPCS;
    Cd          ${CD:-0};
    machine
    {
$SNAP
    }
    measured
    {
$MEASURED
    }
}
EOF

if [ "$NP" -gt 1 ] && grep -q '^End' log.reconstructPar 2>/dev/null; then
    rm -rf processor*
fi
mv log.time "log.time.$STAMP"
[ -f log.machine ] && mv log.machine "log.machine.$STAMP"
for f in log.decomposePar "log.$APP" log.reconstructPar log.perf log.energy; do
    [ -f "$f" ] && xz -T0 --suffix=".$STAMP.xz" "$f"
done

NOTIFY_URL=${NOTIFY_URL:-$(cat "$HOME/.config/aconcagua/notify" 2>/dev/null)}
if [ -n "$NOTIFY_URL" ]; then
    curl -s -m 10 -H "Title: $(basename "$PWD") $STATUS" \
         -d "t = ${T1:-0} s   Cd = ${CD:-?}   $(awk -v w=$WALL 'BEGIN{printf "%.1f h", w/3600}')" \
         "$NOTIFY_URL" > /dev/null || true
fi

echo
echo "status $STATUS   t = ${T1:-0} s   Cd = ${CD:-?}   wall $WALL s   $COST core-us/cell/step"
echo "record: run.info   coefficients: postProcessing/forceCoeffs1/*/coefficient.dat"
echo "y+ per patch: postProcessing/yPlus/*/yPlus.dat   (measure it: the mesh sets no y+ target)"
[ "$STATUS" = ok ]
