# ---------------------------------------------------------------------------
# aconcagua-gmsh / CFD-ITBA-ROCKETRY
# Tracked: mesh generation sources (Python/gmsh), OpenFOAM case dicts, docs.
# Ignored: everything a run regenerates -- meshes, fields, logs, decomposition.
# GitHub rejects files >100 MB, so no generated mesh may be committed.
# ---------------------------------------------------------------------------

# --- Generated meshes (gmsh output, hundreds of MB) ---
*.msh
*.msh2
*.msh4
*.med
*.unv
*.stl
*.step
*.stp
*.brep
*.geo_unrolled

# --- OpenFOAM mesh (written by gmshToFoam / renumberMesh) ---
constant/polyMesh/
constant/*/polyMesh/
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh

# --- checkMesh -writeFields output in 0/ (25 MB each) ---
0/aspectRatio
0/cellAspectRatio
0/cellDeterminant
0/cellVolume
0/cellVolumeRatio
0/faceWeight
0/minPyrVolume
0/minTetVolume
0/nonOrthoAngle
0/skewness
0/wallDistance
0/cellRegion
0/cellShapes
0/cellZone
0/faceZone

# --- Solver output: time directories, keep 0/ (initial conditions) ---
[1-9]*/
0.[0-9]*/
-[0-9]*/
!0/

# --- Parallel decomposition ---
processor*/

# --- Post-processing / visualisation ---
postProcessing/
VTK/
*.foam
*.OpenFOAM
*.vtk
*.vtu
*.vtp
*.pvd
*.pvsm

# --- Logs ---
log
log.*
*.log
logs/
PyFoam*
*.analyzed/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
