FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDictBase;
}
#include "${FOAM_CASE}/system/flowDerived"
#include "${FOAM_CASE}/constant/meshInfo"

// rhoCentralFoam: density-based, explicit, central-upwind shock capturing.
application     rhoPimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;

// endTime: two passes of the flow over the body at M 0.3 (2 x 2.955 / 105).
deltaT          1e-6;
endTime         0.06;

writeControl    adjustable;
writeInterval   0.005;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

// maxCo is convective (|U|, not |U| + c): the acoustics are implicit here.
adjustTimeStep  yes;
maxDeltaT       1e-4;

functions
{
    // -- Force coefficients ------------------------------------------------
    //  Compressible: p is in Pa, so the force integration uses the rho FIELD.
    //  rhoInf is still needed for the dynamic pressure that normalises the
    //  coefficients.  Aref, lRef and the wall patches come from
    //  constant/meshInfo, so they always match the mesh.
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   50;
        log             yes;
        patches         $wallPatches;
        rho             rho;
        rhoInf          $rhoInf;
        dragDir         ($dx $dy $dz);
        liftDir         ($lx $ly $lz);
        CofR            (0 0 0);
        pitchAxis       (0 0 1);
        magUInf         $Uinf;
        lRef            $lRef;
        Aref            $Aref;
    }

    forces1
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   50;
        log             no;
        patches         $wallPatches;
        rho             rho;
        rhoInf          $rhoInf;
        CofR            (0 0 0);
    }

    // -- Mach number: the field to look at.  The bow shock, the expansion
    //    over the boattail and the Mach cone all show up here first.
    MachNo
    {
        type            MachNo;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        writeControl    timeStep;
        fields          (U e k omega);
        writeResidualFields no;
    }

    minMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   10;
        mode            magnitude;
        location        yes;
        fields          (p T rho U);
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        patches         $wallPatches;
    }
    Cp
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        mode            staticCoeff;
        rho             rhoInf;
        rhoInf          $rhoInf;
        pInf            $pInf;
        UInf            ($Ux $Uy $Uz);
        writeControl    writeTime;
    }

}

