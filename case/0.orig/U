FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
#include "${FOAM_CASE}/system/flowDerived"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($Ux $Uy $Uz);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    // cylindrical farfield: with angle of attack part of it is inflow and
    // part outflow, so a free-stream condition rather than slip
    box
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
        value           $internalField;
    }
    // only exists in the quarter and half meshes; ignored otherwise
    symm
    {
        type            symmetry;
    }
    "(cone|walls|tail|fins)"
    {
        type            noSlip;
    }
}

